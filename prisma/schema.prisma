generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(100)
  descripcion String? @db.Text
  platos      Plato[]

  @@map("categorias")
}

model Cliente {
  id       Int      @id @default(autoincrement())
  nombre   String
  telefono String?
  correo   String?
  pedidos  Pedido[]

  @@map("clientes")
}

model Empleado {
  id       Int      @id @default(autoincrement())
  nombre   String
  cargo    String?
  telefono String?
  pedidos  Pedido[]

  @@map("empleados")
}

model Proveedor {
  id          Int     @id @default(autoincrement())
  nombre      String
  contacto    String?
  telefono    String?
  direccion   String? @db.Text

  // Relación con la tabla intermedia ProveedorIngrediente
  ingredientes ProveedorIngrediente[]

  @@map("proveedores")
}

model ProveedorIngrediente {
  id            Int     @id @default(autoincrement())
  proveedorId   Int
  ingredienteId Int

  // Relaciones
  proveedor   Proveedor   @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@unique([proveedorId, ingredienteId])
  @@map("proveedor_ingredientes")
}

model Ingrediente {
  id           Int     @id @default(autoincrement())
  nombre       String
  stockActual  Float   @map("stock_actual")
  unidadMedida String  @map("unidad_medida")

  // Relación inversa hacia tu tabla intermedia
  proveedores ProveedorIngrediente[]

  @@map("ingredientes")
}

model Plato {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String? @db.Text
  precio      Decimal @db.Decimal(10, 2)
  disponible  Boolean @default(true)
  categoriaId Int     @map("categoria_id")

  categoria Categoria       @relation(fields: [categoriaId], references: [id])
  detalles  DetallePedido[]

  @@map("platos")
}

model Pedido {
  id         Int      @id @default(autoincrement())
  fecha      DateTime @default(now())
  estado     String   @default("Pendiente")
  total      Decimal  @default(0) @db.Decimal(10, 2)
  clienteId  Int      @map("cliente_id")
  empleadoId Int      @map("empleado_id")

  cliente  Cliente         @relation(fields: [clienteId], references: [id])
  empleado Empleado        @relation(fields: [empleadoId], references: [id])
  detalles DetallePedido[]

  @@map("pedidos")
}

model DetallePedido {
  id             Int     @id @default(autoincrement())
  pedidoId       Int     @map("pedido_id")
  platoId        Int     @map("plato_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  plato  Plato  @relation(fields: [platoId], references: [id])

  @@map("detalle_pedidos")
}

enum Rol {
  MESERO
  GERENTE
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  correo    String   @unique
  password  String
  rol       Rol      @default(MESERO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("usuarios")
}